# read environment variables from external FILE
ifneq ($(GLOBAL_ENV),1)
ENV_FILE ?= local.env
ifneq ($(ENV_FILE),/dev/null)
include $(ENV_FILE)
export $(shell sed '/^\#/d; s/=.*//' $(ENV_FILE))
endif
endif

.PHONY: all
all: install-dependencies frogservice.toml

.PHONY: clean
clean:
	rm -Rf frogservice.toml env

.PHONY: install-dependencies deps
install-dependencies deps: python-requirements.txt
	@command -v cargo || (echo "Missing dependency: cargo)">&2 && false)
	@command -v rustc || (echo "Missing dependency: rustc">&2 && false)
	@command -v curl || (echo "Missing dependency: curl">&2 && false)
	@command -v envsubst || (echo "Missing dependency: envsubst (On Debian/Ubuntu: apt install gettext-base)">&2 && false)
	@command -v frog || (echo "Missing dependency: frog">&2 && false)
	@command -v clam > /dev/null || cargo install --git https://codeberg.org/proycon/clam --branch clam-4.0 || (echo "Failed to install clam">&2 && false)
ifeq ($(GLOBAL_ENV),1)
	python3 -m pip install --break-system-packages -r $<
else
	$(MAKE) env
endif

env: python-requirements.txt
	@echo "--- Setting up virtual environment ---">&2
	[ ! -d env ] && python3 -m venv env \
		&& . env/bin/activate \
		&& pip install --upgrade pip \
		&& pip install -r $<

frogservice.toml: frogservice.template.toml
	envsubst < $< >$@
	@sed -i '1i # WARNING: DO NOT EDIT THIS FILE DIRECTLY! IT IS GENERATED FROM $<, EDIT THAT ONE INSTEAD' $@

.PHONY: docker
docker:
	docker build -t proycon/frog_webservice:latest .

.PHONY: docker-dev
docker-dev:
	docker build -t proycon/frog_webservice:dev .

.PHONY: run
run: frogservice.toml | install-dependencies
ifeq ($(GLOBAL_ENV),1)
	exec clam --config $< $(CLAM_EXTRA)
else
	. env/bin/activate && exec clam --config $< $(CLAM_EXTRA)
endif

.PHONY: docker-run
docker-run:
	docker run -p 8080:8080 --env CLAM_URL=http://127.0.0.1:8080 --env CLAM_LISTEN=0.0.0.0:8080 -t proycon/frog_webservice:latest

.PHONY: docker-run-dev
docker-run-dev:
	docker run -p 8080:8080 --env CLAM_URL=http://127.0.0.1:8080 --env CLAM_LISTEN=0.0.0.0:8080 -t proycon/frog_webservice:dev

